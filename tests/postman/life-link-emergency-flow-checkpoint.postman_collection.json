{
  "info": {
    "name": "LIFE-LINK Emergency Flow Checkpoint (STAGING ONLY)",
    "description": "Hospital-first end-to-end checkpoint. Uses synthetic accounts and mutating endpoints; NEVER run against production. See docs/testing/emergency-flow-checkpoint.md for fixtures, expected state, and the all-donors-decline limitation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "hospitalToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "donorToken1",
      "value": "",
      "type": "string"
    },
    {
      "key": "donorToken2",
      "value": "",
      "type": "string"
    },
    {
      "key": "donorToken3",
      "value": "",
      "type": "string"
    },
    {
      "key": "hospitalLatitude",
      "value": "12.9716",
      "type": "string"
    },
    {
      "key": "hospitalLongitude",
      "value": "77.5946",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "dispatchId1",
      "value": "",
      "type": "string"
    },
    {
      "key": "dispatchId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "dispatchId3",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Scenario A - Inventory sufficient (stop after inventory)",
      "item": [
        {
          "name": "Create emergency request (hospital)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blood_group\": \"O_POSITIVE\",\n  \"quantity\": 1,\n  \"resource_type\": \"WHOLE_BLOOD\",\n  \"urgency\": \"CRITICAL\",\n  \"hospital_latitude\": \"{{hospitalLatitude}}\",\n  \"hospital_longitude\": \"{{hospitalLongitude}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('request creation returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.request && body.request.id).to.exist;",
                  "pm.collectionVariables.set('requestId', body.request.id);",
                  "pm.test('creation does not falsely claim inventory is resolved', () => pm.expect(body.resolution.status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve inventory (must use a pre-seeded matching inventory fixture)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/resolve/inventory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('inventory resolution returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('inventory fully covers request', () => { pm.expect(body.fullyReserved).to.eql(true); pm.expect(body.allocatedUnits).to.eql(body.requestedUnits); pm.expect(body.remainingUnits).to.eql(0); });",
                  "pm.test('stop after inventory; do not run donor dispatch requests in this scenario', () => pm.expect(body.fullyReserved).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Scenario B - Insufficient inventory and donor tracking (fixture-driven)",
      "description": "Run only with a synthetic request/inventory fixture whose requestId is set in the collection variable. Donor tokens must correspond to the dispatches returned by next-batch.",
      "item": [
        {
          "name": "Get eligible donors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/eligible-donors"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('eligible donor lookup returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('candidate list is an array', () => pm.expect(body.donors).to.be.an('array'));",
                  "pm.test('ranking outcome is explicit', () => pm.expect(body.ranking && body.ranking.status).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create next donor dispatch batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/donor-dispatches/next-batch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchSize\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('batch creation returns 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.test('dispatches is an array', () => pm.expect(body.dispatches).to.be.an('array'));",
                  "body.dispatches.slice(0,3).forEach((d,i) => { if (d.id) pm.collectionVariables.set('dispatchId'+(i+1), d.id); });",
                  "pm.collectionVariables.set('lastBatchReason', body.reason || 'BATCH_CREATED');"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 1 accepts (then run tracking steps as that donor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/respond",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"ACCEPT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('donor response is accepted', () => pm.response.to.have.status(200));",
                  "pm.test('acceptance response is valid JSON', () => pm.expect(pm.response.json()).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 1 starts tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/tracking/start",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run only after donor 1 accepted. If endpoint requires fields, follow its response/schema and use synthetic values."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tracking start returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 1 records synthetic location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/location",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 12.972,\n  \"longitude\": 77.595\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('synthetic location update succeeds', () => pm.expect([200,201]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 1 arrives",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/tracking/arrive",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('arrival transition succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Hospital completes dispatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/tracking/complete",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('hospital completion transition succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Scenario C - All donors decline (fixture-driven)",
      "description": "Run with at least 3 synthetic eligible donors and an insufficient-inventory request. Use a distinct donor token for each dispatch. After exhausting batches, explicitly call peer-bank resolution; automatic fallback is not yet verified.",
      "item": [
        {
          "name": "Donor 1 declines",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken1}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId1}}/respond",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"DECLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('donor 1 decline accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 2 declines",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken2}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId2}}/respond",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"DECLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('donor 2 decline accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Donor 3 declines",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken3}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/donor-dispatches/{{dispatchId3}}/respond",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"DECLINE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('donor 3 decline accepted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask for next batch / observe exhaustion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/donor-dispatches/next-batch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchSize\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('exhaustion check returns 200 or 201', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('lastBatchReason', body.reason || 'BATCH_CREATED');",
                  "if (!body.dispatches || body.dispatches.length === 0) pm.test('exhaustion has explicit reason', () => pm.expect(body.reason).to.be.oneOf(['NO_ELIGIBLE_DONORS','NO_AVAILABLE_NEXT_BATCH','REQUEST_ALREADY_FULFILLED']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Peer-bank fallback (explicit; automatic behavior not yet proven)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{hospitalToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/resolve/peer-banks",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('peer-bank resolution responds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('remaining quantity and offers are explicit', () => { pm.expect(body.remainingUnits).to.be.a('number'); pm.expect(body.offers).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}