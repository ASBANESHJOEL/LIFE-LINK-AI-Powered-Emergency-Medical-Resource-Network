# Supabase PostgreSQL Configuration
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-service-role-key>

# ML Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
ML_ALLOWED_ORIGINS=
# Required for the protected experimental /rank endpoint. Generate a long random secret.
ML_RANKING_API_KEY=<set-the-same-long-random-secret-as-the-backend>
# Optional override for the trained V2 artifact path. The artifact must be trained and deployed separately.
LIFE_LINK_RANKER_MODEL_PATH=ml/models/donor_ranker_mlp_v2.joblib
