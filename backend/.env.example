# Backend Environment Variables (Railway / Local)
PORT=3000
NODE_ENV=production
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>
FRONTEND_URL=https://life-link-ai-powered-emergency-medi.vercel.app
ML_API_URL=https://<your-ml-service-host>
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=5000

# Strictly local development tracking test harness.
# Keep disabled in all deployed environments.
LIFELINK_DEV_AUTH_ENABLED=false
LIFELINK_DEV_EMAIL=dev-donor@lifelink.test
LIFELINK_DEV_OTP=00000000
LIFELINK_DEV_DONOR_USER_ID=<synthetic-donor-user-uuid>

# Emergency Critical Path & Donor Resilience Thresholds (Authoritative Backend Defaults)
# Safe fallback defaults are used if environment variables are not supplied:
# GPS grace period allowed before dispatch release (minutes, default: 5)
GPS_GRACE_PERIOD_MINUTES=5
# Stale telemetry threshold for in-transit donors (minutes, default: 5)
STALE_LOCATION_THRESHOLD_MINUTES=5
# Maximum acceptable travel ETA threshold before candidate reassignment (minutes, default: 60)
MAX_ACCEPTABLE_ETA_MINUTES=60
