# Backend Environment Variables (Railway / Local)
PORT=3000
NODE_ENV=production
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your-secret-key>
FRONTEND_URL=https://life-link-ai-powered-emergency-medi.vercel.app
ML_API_URL=https://<your-ml-service-host>
# V2 ranking is opt-in. Keep false until the experimental model has been reviewed.
ML_RANKING_ENABLED=false
# Must match ML_RANKING_API_KEY configured on the ML service. Use a long random secret.
ML_RANKING_API_KEY=<set-a-long-random-secret>
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=5000

# Strictly local development tracking test harness.
# Keep disabled in all deployed environments.
# Local judge/demo auth only. Keep false in production.
LIFELINK_DEV_AUTH_ENABLED=false
LIFELINK_DEV_EMAIL=donor002@lifelink.test
LIFELINK_DEV_DONOR_USER_ID=<synthetic-donor-user-uuid>
LIFELINK_DEV_HOSPITAL_EMAIL=hospital.staff021@lifelink.test
LIFELINK_DEV_HOSPITAL_USER_ID=<synthetic-hospital-user-uuid>
LIFELINK_DEV_BLOOD_BANK_EMAIL=bank.staff002@lifelink.test
LIFELINK_DEV_BLOOD_BANK_USER_ID=<synthetic-blood-bank-user-uuid>
LIFELINK_DEV_ADMIN_EMAIL=hospital.staff010@lifelink.test
LIFELINK_DEV_ADMIN_USER_ID=<synthetic-admin-user-uuid>

# Emergency Critical Path & Donor Resilience Thresholds (Authoritative Backend Defaults)
GPS_GRACE_PERIOD_MINUTES=5
STALE_LOCATION_THRESHOLD_MINUTES=5
MAX_ACCEPTABLE_ETA_MINUTES=60

# Production Observability & Request Correlation
ENABLE_TEST_REQUEST_LOGS=false
